# Where kk's source comes from. `kk` is not a fork: the tree is fetched at the
# pinned ref and the patches in patches/ are applied on top, so a rebase onto a
# newer upstream is a one-line edit here plus whatever the patches need.
#
# KWWK_REF is pinned to a commit rather than a branch on purpose. patches/ is
# context-sensitive, so a moving branch turns "the build broke" into "which of
# the last twenty upstream commits broke it". Bump it deliberately:
#
#     make bump-upstream KWWK_REF=<sha>   # refetch, reapply, rebuild
#
KWWK_REPO=https://github.com/EYHN/kwwk.git
KWWK_REF=15810862000440c564ae1045f0f8d48425fce40a

# The SwiftPM product to build, and the name it ships as on device. Renaming
# the product upstream would also rename the resource bundle SwiftPM generates
# (`kwwk_KWWKAI.bundle`, derived from the *package* name), so the rename to
# `kk` happens at install time instead of in Package.swift.
KWWK_PRODUCT=kwwk
KK_PROGRAM=kk

# Deployment target. Matches upstream Package.swift's .iOS(.v15): 15.0 is where
# Swift Concurrency became part of the OS, so no concurrency back-deployment
# dylibs have to ship in the .deb. It is also below every jailbreak that can
# install this, which is the point. SwiftPM raises every target to the
# package's floor, so this cannot go lower than upstream's.
KK_MIN_IOS=15.0

# One arm64 binary backs both packages. arm64 runs on every arm64e device, the
# reverse is not true, and the two .deb architectures here name a bootstrap
# layout rather than a CPU — see Packaging/DEBIAN/control and the Makefile.
KK_ARCH=arm64
