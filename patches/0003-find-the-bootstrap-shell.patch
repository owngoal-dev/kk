@@ -4,7 +4,19 @@ import KWWKAI
 /// SDK-safe default shell for command execution. CLI entry points may override
 /// this with the user's configured shell after explicitly opting into CLI
 /// ambient behavior.
+#if os(iOS)
+/// The launcher exports physical bootstrap directories in PATH. Swift does
+/// not share a RootHide shell's virtual filesystem view. Retain fixed probes
+/// for direct invocation on other bootstrap layouts.
+public let kwwkDefaultShellPath: String = {
+    let pathShells = (ProcessInfo.processInfo.environment["PATH"] ?? "")
+        .split(separator: ":").filter { $0.hasPrefix("/") }.map { "\($0)/sh" }
+    let candidates = pathShells + ["/var/jb/bin/sh", "/bin/sh", "/var/jb/usr/bin/sh", "/usr/bin/sh"]
+    return candidates.first { FileManager.default.isExecutableFile(atPath: $0) } ?? "/bin/sh"
+}()
+#else
 public let kwwkDefaultShellPath = "/bin/sh"
+#endif
 
