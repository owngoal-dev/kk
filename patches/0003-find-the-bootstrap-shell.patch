@@ -4,7 +4,18 @@ import KWWKAI
 /// SDK-safe default shell for command execution. CLI entry points may override
 /// this with the user's configured shell after explicitly opting into CLI
 /// ambient behavior.
+#if os(iOS)
+/// Probed rather than hardcoded: a rootless bootstrap installs its shell under
+/// /var/jb and leaves /bin/sh absent, while roothide's programs resolve
+/// unprefixed paths inside the jbroot they picked this boot. The last entry is
+/// the unreachable-but-honest default when no bootstrap answers.
+public let kwwkDefaultShellPath: String = {
+    let candidates = ["/var/jb/bin/sh", "/bin/sh", "/var/jb/usr/bin/sh", "/usr/bin/sh"]
+    return candidates.first { FileManager.default.isExecutableFile(atPath: $0) } ?? "/bin/sh"
+}()
+#else
 public let kwwkDefaultShellPath = "/bin/sh"
+#endif
 
 /// Runtime command boundary for shell-enabled coding tools.
